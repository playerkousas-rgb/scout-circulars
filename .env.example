# Copy to .env for local serve_local.py / notify.py experiments. Never commit .env.
# Vercel receives only SUPABASE_URL, SUPABASE_SERVICE_KEY and VAPID_PUBLIC_KEY.
# GitHub Actions also needs VAPID_PRIVATE_KEY. Keep it out of Vercel and browsers.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=replace-with-service-role-key
VAPID_PUBLIC_KEY=replace-with-base64url-public-key
VAPID_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-pem\n-----END PRIVATE KEY-----"
# Optional VAPID contact / origin. A https URL avoids placing an email in requests.
VAPID_SUBJECT=https://scout-circulars.vercel.app
# Must be the same public HTTPS origin where users subscribe; every Push opens its library ?n= result here.
SITE_URL=https://scout-circulars.vercel.app
