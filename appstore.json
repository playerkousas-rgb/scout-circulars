    "fetched_at": "2026-10-20",
    "tables": {
      "pages": "id(text pk), label, icon, enabled, sort_order",
      "categories": "(page,name) 複合主鍵, icon, sort_order",
      "apps": "id(uuid pk), name, url, github, description, note, icon, icon_source, category, page, tags[], visible, clicks, stars, hearts, featured, sort_order, created_at",
      "submissions": "id(uuid pk), name, url, description, author, page, category, tags[], status(pending/approved/rejected), created_at, reviewed_at, app_id"
    },
    "rpcs": [
      "bump_clicks(p_id)",
      "bump_stars(p_id,p_delta)",
      "bump_hearts(p_id,p_delta)",
      "submit_work(jsonb)",
      "review_work(uuid,boolean)"
    ],
    "rls": "pages/categories：公開 SELECT、authenticated admin 先可寫；apps：公開 SELECT 限 visible=true、admin 先可寫；submissions：匿名只可經 submit_work 投稿、admin 經 review_work 審批。is_store_admin() = auth email = admin_email。",
    "migrations": [
      "README 基礎 schema",
      "migrations/20260924-market.sql",
      "migrations/20260924-hearts.sql"
    ],
    "vercel_env_keys": [
      "ADMIN_PIN",
      "SUPABASE_URL",
      "SUPABASE_ANON_KEY",
      "ADMIN_EMAIL",
      "ADMIN_AUTH_PASSWORD"
    ],
    "same_project_as_circulars_push": true,
    "same_project_note": "用戶 2026-09-24 確認：通告圖書館 push_subscriptions 同 App Store 共用此 project；故 repo 現有 SUPABASE_SERVICE_KEY secret 即此 project 嘅 service key（新格式可為 sb_secret_…，舊格式 eyJ… role=service_role）。改名（display name）唔影響；ref／subdomain 唔可以改（URL 同所有 key 綁定 ref）。"
  },
